# Copy to .env and fill in real values
TENSORUS_API_KEYS=your_api_key_here
POSTGRES_USER=tensorus_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tensorus_db
# pgAdmin login (optional, defaults shown)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
# MinIO (S3-compatible storage for the LanceDB s3 scenario, step 17d).
# The server reads MINIO_ROOT_*; clients read the same values as AWS_*.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
